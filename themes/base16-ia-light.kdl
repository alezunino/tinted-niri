layout {
    focus-ring {
        active-color "#38781c"
        inactive-color "#898989"
        urgent-color "#9c5a02"
    }

    border {
        width 3
        active-color "#38781c"
        inactive-color "#898989"
        urgent-color "#9c5a02"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#a94598"
        inactive-color "#9c5a02"
    }

    border {
        on
        inactive-color "#9c5a02"
    }

    shadow {
        color "#9c5a02F0"
    }

    tab-indicator {
        active-color "#a94598"
        inactive-color "#9c5a02"
    }
}
