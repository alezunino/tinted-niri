layout {
    focus-ring {
        active-color "#a6e3a1"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }

    border {
        width 3
        active-color "#a6e3a1"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#cba6f7"
        inactive-color "#f38ba8"
    }

    border {
        on
        inactive-color "#f38ba8"
    }

    shadow {
        color "#f38ba8F0"
    }

    tab-indicator {
        active-color "#cba6f7"
        inactive-color "#f38ba8"
    }
}
