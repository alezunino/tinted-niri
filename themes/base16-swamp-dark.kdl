layout {
    focus-ring {
        active-color "#7a7653"
        inactive-color "#5f4e41"
        urgent-color "#db930d"
    }

    border {
        width 3
        active-color "#7a7653"
        inactive-color "#5f4e41"
        urgent-color "#db930d"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#91506c"
        inactive-color "#db930d"
    }

    border {
        on
        inactive-color "#db930d"
    }

    shadow {
        color "#db930dF0"
    }

    tab-indicator {
        active-color "#91506c"
        inactive-color "#db930d"
    }
}
