layout {
    focus-ring {
        active-color "#33ff00"
        inactive-color "#808080"
        urgent-color "#ff0000"
    }

    border {
        width 3
        active-color "#33ff00"
        inactive-color "#808080"
        urgent-color "#ff0000"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#cc00ff"
        inactive-color "#ff0000"
    }

    border {
        on
        inactive-color "#ff0000"
    }

    shadow {
        color "#ff0000F0"
    }

    tab-indicator {
        active-color "#cc00ff"
        inactive-color "#ff0000"
    }
}
