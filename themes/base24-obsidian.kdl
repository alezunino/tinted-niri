layout {
    focus-ring {
        active-color "#00bb00"
        inactive-color "#6e6e6e"
        urgent-color "#a50001"
    }

    border {
        width 3
        active-color "#00bb00"
        inactive-color "#6e6e6e"
        urgent-color "#a50001"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#bb00bb"
        inactive-color "#a50001"
    }

    border {
        on
        inactive-color "#a50001"
    }

    shadow {
        color "#a50001F0"
    }

    tab-indicator {
        active-color "#bb00bb"
        inactive-color "#a50001"
    }
}
