layout {
    focus-ring {
        active-color "#008b00"
        inactive-color "#6e6e6e"
        urgent-color "#9f0000"
    }

    border {
        width 3
        active-color "#008b00"
        inactive-color "#6e6e6e"
        urgent-color "#9f0000"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#bc00ca"
        inactive-color "#9f0000"
    }

    border {
        on
        inactive-color "#9f0000"
    }

    shadow {
        color "#9f0000F0"
    }

    tab-indicator {
        active-color "#bc00ca"
        inactive-color "#9f0000"
    }
}
