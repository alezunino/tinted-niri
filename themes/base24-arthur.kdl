layout {
    focus-ring {
        active-color "#86af80"
        inactive-color "#6e5d59"
        urgent-color "#cd5c5c"
    }

    border {
        width 3
        active-color "#86af80"
        inactive-color "#6e5d59"
        urgent-color "#cd5c5c"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#deb887"
        inactive-color "#cd5c5c"
    }

    border {
        on
        inactive-color "#cd5c5c"
    }

    shadow {
        color "#cd5c5cF0"
    }

    tab-indicator {
        active-color "#deb887"
        inactive-color "#cd5c5c"
    }
}
