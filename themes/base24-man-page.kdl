layout {
    focus-ring {
        active-color "#00a600"
        inactive-color "#7f7f7f"
        urgent-color "#cc0000"
    }

    border {
        width 3
        active-color "#00a600"
        inactive-color "#7f7f7f"
        urgent-color "#cc0000"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#b200b2"
        inactive-color "#cc0000"
    }

    border {
        on
        inactive-color "#cc0000"
    }

    shadow {
        color "#cc0000F0"
    }

    tab-indicator {
        active-color "#b200b2"
        inactive-color "#cc0000"
    }
}
