layout {
    focus-ring {
        active-color "#008400"
        inactive-color "#878787"
        urgent-color "#bf0000"
    }

    border {
        width 3
        active-color "#008400"
        inactive-color "#878787"
        urgent-color "#bf0000"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#6b40c3"
        inactive-color "#bf0000"
    }

    border {
        on
        inactive-color "#bf0000"
    }

    shadow {
        color "#bf0000F0"
    }

    tab-indicator {
        active-color "#6b40c3"
        inactive-color "#bf0000"
    }
}
