layout {
    focus-ring {
        active-color "#7bb75b"
        inactive-color "#80827f"
        urgent-color "#ce3e60"
    }

    border {
        width 3
        active-color "#7bb75b"
        inactive-color "#80827f"
        urgent-color "#ce3e60"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#a57fc4"
        inactive-color "#ce3e60"
    }

    border {
        on
        inactive-color "#ce3e60"
    }

    shadow {
        color "#ce3e60F0"
    }

    tab-indicator {
        active-color "#a57fc4"
        inactive-color "#ce3e60"
    }
}
