layout {
    focus-ring {
        active-color "#a6e32d"
        inactive-color "#7c7c7c"
        urgent-color "#e52222"
    }

    border {
        width 3
        active-color "#a6e32d"
        inactive-color "#7c7c7c"
        urgent-color "#e52222"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#fa2573"
        inactive-color "#e52222"
    }

    border {
        on
        inactive-color "#e52222"
    }

    shadow {
        color "#e52222F0"
    }

    tab-indicator {
        active-color "#fa2573"
        inactive-color "#e52222"
    }
}
