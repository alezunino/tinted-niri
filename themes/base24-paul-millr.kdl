layout {
    focus-ring {
        active-color "#79ff0f"
        inactive-color "#7b7b7b"
        urgent-color "#ff0000"
    }

    border {
        width 3
        active-color "#79ff0f"
        inactive-color "#7b7b7b"
        urgent-color "#ff0000"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#b349be"
        inactive-color "#ff0000"
    }

    border {
        on
        inactive-color "#ff0000"
    }

    shadow {
        color "#ff0000F0"
    }

    tab-indicator {
        active-color "#b349be"
        inactive-color "#ff0000"
    }
}
