layout {
    focus-ring {
        active-color "#8f9d6a"
        inactive-color "#5f5a60"
        urgent-color "#cf6a4c"
    }

    border {
        width 3
        active-color "#8f9d6a"
        inactive-color "#5f5a60"
        urgent-color "#cf6a4c"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#9b859d"
        inactive-color "#cf6a4c"
    }

    border {
        on
        inactive-color "#cf6a4c"
    }

    shadow {
        color "#cf6a4cF0"
    }

    tab-indicator {
        active-color "#9b859d"
        inactive-color "#cf6a4c"
    }
}
