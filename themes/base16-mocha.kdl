layout {
    focus-ring {
        active-color "#beb55b"
        inactive-color "#7e705a"
        urgent-color "#cb6077"
    }

    border {
        width 3
        active-color "#beb55b"
        inactive-color "#7e705a"
        urgent-color "#cb6077"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#a89bb9"
        inactive-color "#cb6077"
    }

    border {
        on
        inactive-color "#cb6077"
    }

    shadow {
        color "#cb6077F0"
    }

    tab-indicator {
        active-color "#a89bb9"
        inactive-color "#cb6077"
    }
}
