layout {
    focus-ring {
        active-color "#008700"
        inactive-color "#858585"
        urgent-color "#d70000"
    }

    border {
        width 3
        active-color "#008700"
        inactive-color "#858585"
        urgent-color "#d70000"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#8700af"
        inactive-color "#d70000"
    }

    border {
        on
        inactive-color "#d70000"
    }

    shadow {
        color "#d70000F0"
    }

    tab-indicator {
        active-color "#8700af"
        inactive-color "#d70000"
    }
}
