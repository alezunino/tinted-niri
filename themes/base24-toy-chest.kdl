layout {
    focus-ring {
        active-color "#199171"
        inactive-color "#2f8288"
        urgent-color "#be2d26"
    }

    border {
        width 3
        active-color "#199171"
        inactive-color "#2f8288"
        urgent-color "#be2d26"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#8a5ddb"
        inactive-color "#be2d26"
    }

    border {
        on
        inactive-color "#be2d26"
    }

    shadow {
        color "#be2d26F0"
    }

    tab-indicator {
        active-color "#8a5ddb"
        inactive-color "#be2d26"
    }
}
