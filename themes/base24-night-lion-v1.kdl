layout {
    focus-ring {
        active-color "#5ede8f"
        inactive-color "#6e6e6e"
        urgent-color "#bb0000"
    }

    border {
        width 3
        active-color "#5ede8f"
        inactive-color "#6e6e6e"
        urgent-color "#bb0000"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#bb00bb"
        inactive-color "#bb0000"
    }

    border {
        on
        inactive-color "#bb0000"
    }

    shadow {
        color "#bb0000F0"
    }

    tab-indicator {
        active-color "#bb00bb"
        inactive-color "#bb0000"
    }
}
