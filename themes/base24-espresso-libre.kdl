layout {
    focus-ring {
        active-color "#1a921c"
        inactive-color "#737772"
        urgent-color "#cc0000"
    }

    border {
        width 3
        active-color "#1a921c"
        inactive-color "#737772"
        urgent-color "#cc0000"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#c5656b"
        inactive-color "#cc0000"
    }

    border {
        on
        inactive-color "#cc0000"
    }

    shadow {
        color "#cc0000F0"
    }

    tab-indicator {
        active-color "#c5656b"
        inactive-color "#cc0000"
    }
}
