layout {
    focus-ring {
        active-color "#78c06e"
        inactive-color "#676e95"
        urgent-color "#6e98e1"
    }

    border {
        width 3
        active-color "#78c06e"
        inactive-color "#676e95"
        urgent-color "#6e98e1"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#c792ea"
        inactive-color "#6e98e1"
    }

    border {
        on
        inactive-color "#6e98e1"
    }

    shadow {
        color "#6e98e1F0"
    }

    tab-indicator {
        active-color "#c792ea"
        inactive-color "#6e98e1"
    }
}
