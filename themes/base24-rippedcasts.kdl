layout {
    focus-ring {
        active-color "#a7ff60"
        inactive-color "#7c7c7c"
        urgent-color "#cdaf95"
    }

    border {
        width 3
        active-color "#a7ff60"
        inactive-color "#7c7c7c"
        urgent-color "#cdaf95"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#ff73fd"
        inactive-color "#cdaf95"
    }

    border {
        on
        inactive-color "#cdaf95"
    }

    shadow {
        color "#cdaf95F0"
    }

    tab-indicator {
        active-color "#ff73fd"
        inactive-color "#cdaf95"
    }
}
