layout {
    focus-ring {
        active-color "#74af68"
        inactive-color "#66786e"
        urgent-color "#ff4242"
    }

    border {
        width 3
        active-color "#74af68"
        inactive-color "#66786e"
        urgent-color "#ff4242"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#9413e5"
        inactive-color "#ff4242"
    }

    border {
        on
        inactive-color "#ff4242"
    }

    shadow {
        color "#ff4242F0"
    }

    tab-indicator {
        active-color "#9413e5"
        inactive-color "#ff4242"
    }
}
