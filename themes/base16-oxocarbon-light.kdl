layout {
    focus-ring {
        active-color "#42be65"
        inactive-color "#a1acba"
        urgent-color "#ff7eb6"
    }

    border {
        width 3
        active-color "#42be65"
        inactive-color "#a1acba"
        urgent-color "#ff7eb6"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#be95ff"
        inactive-color "#ff7eb6"
    }

    border {
        on
        inactive-color "#ff7eb6"
    }

    shadow {
        color "#ff7eb6F0"
    }

    tab-indicator {
        active-color "#be95ff"
        inactive-color "#ff7eb6"
    }
}
