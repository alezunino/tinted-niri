layout {
    focus-ring {
        active-color "#a5c261"
        inactive-color "#5a647e"
        urgent-color "#da4939"
    }

    border {
        width 3
        active-color "#a5c261"
        inactive-color "#5a647e"
        urgent-color "#da4939"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#b6b3eb"
        inactive-color "#da4939"
    }

    border {
        on
        inactive-color "#da4939"
    }

    shadow {
        color "#da4939F0"
    }

    tab-indicator {
        active-color "#b6b3eb"
        inactive-color "#da4939"
    }
}
