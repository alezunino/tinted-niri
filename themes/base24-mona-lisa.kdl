layout {
    focus-ring {
        active-color "#626132"
        inactive-color "#a26734"
        urgent-color "#9b281b"
    }

    border {
        width 3
        active-color "#626132"
        inactive-color "#a26734"
        urgent-color "#9b281b"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#9b1d29"
        inactive-color "#9b281b"
    }

    border {
        on
        inactive-color "#9b281b"
    }

    shadow {
        color "#9b281bF0"
    }

    tab-indicator {
        active-color "#9b1d29"
        inactive-color "#9b281b"
    }
}
