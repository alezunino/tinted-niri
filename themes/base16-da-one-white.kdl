layout {
    focus-ring {
        active-color "#76a85d"
        inactive-color "#585858"
        urgent-color "#de5d6e"
    }

    border {
        width 3
        active-color "#76a85d"
        inactive-color "#585858"
        urgent-color "#de5d6e"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#c173d1"
        inactive-color "#de5d6e"
    }

    border {
        on
        inactive-color "#de5d6e"
    }

    shadow {
        color "#de5d6eF0"
    }

    tab-indicator {
        active-color "#c173d1"
        inactive-color "#de5d6e"
    }
}
