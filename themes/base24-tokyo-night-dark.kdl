layout {
    focus-ring {
        active-color "#9ece6a"
        inactive-color "#444b6a"
        urgent-color "#c0caf5"
    }

    border {
        width 3
        active-color "#9ece6a"
        inactive-color "#444b6a"
        urgent-color "#c0caf5"
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#bb9af7"
        inactive-color "#c0caf5"
    }

    border {
        on
        inactive-color "#c0caf5"
    }

    shadow {
        color "#c0caf5F0"
    }

    tab-indicator {
        active-color "#bb9af7"
        inactive-color "#c0caf5"
    }
}
